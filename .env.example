# ── ForceHub Bot — Environment Variables ──────────────────────────
# Copy to .env for local dev, or set in Vercel Dashboard > Settings > Environment Variables

# Your bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated admin Telegram user IDs
ADMIN_IDS=5695957392

# Your Vercel deployment URL (set AFTER first deploy)
# Example: https://forcehub-abc123.vercel.app
WEBHOOK_URL=https://your-app.vercel.app

# Data directory — use /tmp on Vercel (ephemeral, resets on redeploy)
# For persistent data, use Railway instead
DATA_DIR=/tmp
