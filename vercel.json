{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "BOT_TOKEN":    "@bot_token",
    "ADMIN_IDS":    "@admin_ids",
    "WEBHOOK_URL":  "@webhook_url",
    "DATA_DIR":     "/tmp"
  }
}
